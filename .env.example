# Kibitz AI settings. Copy to .env and fill in the keys you use: cp .env.example .env
# .env is git-ignored; never commit real keys. Only the AI gateway (scripts/serve.mjs --api,
# started by `just serve`) reads these, at startup; they never reach the browser.

# Which provider the tutor and chat use: anthropic | openai | mistral | ollama | browser (the in-browser
# model, see `just offline`) | mock (offline test replies)
AI_PROVIDER=anthropic
# Local only: never use a cloud provider; Ollama takes over if it's set up, else the in-browser model. The coach settings in
# the page can switch provider and local-only mode until the server restarts (TODO 2.14).
AI_LOCAL_ONLY=

# Models per task (TODO 2.10): <PROVIDER>_MODEL is used for chat; <PROVIDER>_MODEL_QUICK for the
# quick-question chips and <PROVIDER>_MODEL_REVIEW for game reviews and study plans fall back to it.

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
# Small and fast. For deeper answers: claude-sonnet-5-5 or claude-opus-5-5.
ANTHROPIC_MODEL=claude-haiku-5-5
# ANTHROPIC_MODEL_QUICK=claude-haiku-5-5
# ANTHROPIC_MODEL_REVIEW=claude-sonnet-5-5
# How much the model thinks: low | medium | high | xhigh | max. Empty omits it (for models without effort support).
ANTHROPIC_EFFORT=medium
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- OpenAI ---
OPENAI_API_KEY=
# Small, high-volume model per the API docs as of 2026-10 (flagship: gpt-6-astra);
# check https://developers.openai.com/api/docs/models
OPENAI_MODEL=gpt-6-luna
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Mistral ---
MISTRAL_API_KEY=
# Alias that Mistral repoints to its current small model; see https://docs.mistral.ai/models
MISTRAL_MODEL=mistral-small-latest
# MISTRAL_BASE_URL=https://api.mistral.ai/v1

# --- Ollama (local, no key) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
# A model you have pulled; run `ollama list`
OLLAMA_MODEL=
# Hosts the server may contact for Ollama (SSRF guard, TODO 2.12)
OLLAMA_ALLOWED_HOSTS=127.0.0.1,localhost

# --- In-browser model (TODO 2.16; `just offline` downloads it into site/models/) ---
# qwen2.5-1.5b (default, about 1.1 GB) or qwen2.5-0.5b (about 0.5 GB); see site/server/models.mjs
BROWSER_MODEL=

# --- Embeddings for RAG (TODO 8.3) ---
# Library > Search study text > By meaning or Combined: explicitly build the selected index, then search.
# Keyword search is local and makes no embedding requests. Vectors are memory-only.
# Anthropic has no embeddings API, so this must be openai | mistral | ollama (or mock for tests).
# The key and base URL are that provider's settings above.
EMBEDDING_PROVIDER=ollama
# Empty means the provider's default (openai: text-embedding-3-small, mistral: mistral-embed).
# Ollama has no default: set a model you have pulled, e.g. nomic-embed-text.
EMBEDDING_MODEL=
# Optional operator-supplied immutable model revision/digest; empty records an unknown revision.
# Changing it requires rebuilding. It is recorded, not independently verified against model weights.
EMBEDDING_REVISION=
# Local-only blocks cloud embeddings independently of the chat provider. Ollama must expose
# /api/show metadata identifying a locally installed embedding model; cloud aliases are refused.
# Embeddings share AI_* budgets/rate limits. Add the embedding model to AI_PRICES for cost estimates.

# --- Limits (TODO 2.11) ---
AI_MAX_OUTPUT_TOKENS=16000
AI_TIMEOUT_MS=60000
AI_RATE_LIMIT_PER_MINUTE=20
AI_RATE_LIMIT_PER_USER_PER_MINUTE=20
# Tokens (input + output) per day for the whole server; 0 or empty means no budget. Resets at
# local midnight. The serve recipes persist counters across restarts (--usage FILE).
AI_TOKEN_BUDGET_PER_DAY=0
# Per user and day, for paid models only (Anthropic, OpenAI, Mistral); 0 or empty means no budget.
# Paid daily budgets do not limit Ollama/mock; gateway rate and server token limits still apply.
# The in-browser model does not use gateway accounting. An anonymous cookie groups local usage;
# clearing it starts a new user, while the server-wide limits still apply. Hosted accounts are
# deferred. The cost budget needs prices in AI_PRICES; unpriced tokens have no dollar estimate.
# These are admission thresholds on completed usage, not hard billing caps: in-flight work,
# provider retries or a process crash can exceed/under-report them. Set provider-side spending caps.
AI_TOKEN_BUDGET_PER_USER_PER_DAY=0
# In US dollars, e.g. 0.50
AI_COST_BUDGET_PER_USER_PER_DAY=0
# For the cost estimate in the coach settings: US dollars per million input/output tokens, per
# model, e.g. AI_PRICES=claude-haiku-5-5=1/5,claude-sonnet-5-5=3/15. Check your provider's
# current prices; models without a price are counted in tokens only.
AI_PRICES=
