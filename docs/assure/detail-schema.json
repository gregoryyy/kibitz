{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kibitz detailed reference lineage, version 2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "level",
    "extractor",
    "baseSha256",
    "exclusions",
    "inputs",
    "nodes",
    "edges",
    "unresolved"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "level": {
      "enum": [
        2,
        3
      ]
    },
    "extractor": {
      "const": "kibitz-detail-1"
    },
    "baseSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "exclusions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "externalImportCalls",
        "memberOrDynamicCalls"
      ],
      "properties": {
        "externalImportCalls": {
          "type": "integer",
          "minimum": 0
        },
        "memberOrDynamicCalls": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "name",
              "kind",
              "source",
              "locator"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "const": "object"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "line",
                  "endLine"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "line": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "endLine": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              "locator": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "start",
                  "end",
                  "sha256",
                  "selector",
                  "parser"
                ],
                "properties": {
                  "start": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "selector": {
                    "type": "string",
                    "minLength": 1
                  },
                  "parser": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "name",
              "anchor",
              "source",
              "locator"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "const": "section"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "anchor": {
                "type": "string"
              },
              "source": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "line",
                  "endLine"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "line": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "endLine": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              "locator": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "start",
                  "end",
                  "sha256",
                  "selector",
                  "parser"
                ],
                "properties": {
                  "start": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "selector": {
                    "type": "string",
                    "minLength": 1
                  },
                  "parser": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "name",
              "language",
              "source",
              "locator"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "const": "doc_block"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "language": {
                "type": "string"
              },
              "source": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "line",
                  "endLine"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "line": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "endLine": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              "locator": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "start",
                  "end",
                  "sha256",
                  "selector",
                  "parser"
                ],
                "properties": {
                  "start": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "selector": {
                    "type": "string",
                    "minLength": 1
                  },
                  "parser": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "name",
              "number",
              "url",
              "state",
              "head",
              "base",
              "filesComplete"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "const": "pull_request"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "number": {
                "type": "integer",
                "minimum": 1
              },
              "url": {
                "type": "string",
                "minLength": 1
              },
              "state": {
                "enum": [
                  "OPEN",
                  "CLOSED",
                  "MERGED"
                ]
              },
              "head": {
                "type": "string",
                "minLength": 1
              },
              "base": {
                "type": "string",
                "minLength": 1
              },
              "filesComplete": {
                "enum": [
                  true,
                  false
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "name",
              "number",
              "anchor",
              "text",
              "source",
              "locator"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "const": "pr_section"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "number": {
                "type": "integer",
                "minimum": 1
              },
              "anchor": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "source": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "line",
                  "endLine"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "line": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "endLine": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              "locator": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "start",
                  "end",
                  "sha256",
                  "selector",
                  "parser"
                ],
                "properties": {
                  "start": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "selector": {
                    "type": "string",
                    "minLength": 1
                  },
                  "parser": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "name",
              "url"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "const": "external"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "confidence",
          "type",
          "from",
          "to",
          "evidence"
        ],
        "properties": {
          "confidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "method",
              "policy",
              "rationale"
            ],
            "properties": {
              "value": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "method": {
                "enum": [
                  "observed",
                  "rule",
                  "analyst"
                ]
              },
              "policy": {
                "const": "typed-links-1"
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "type": {
            "enum": [
              "contains_object",
              "calls",
              "references_binding",
              "imports_binding",
              "contains_section",
              "contains_block",
              "locates_item",
              "mentions_object",
              "documents_link",
              "has_description",
              "changes_file",
              "references_item",
              "mentions_file"
            ]
          },
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "reference",
              "resolution"
            ],
            "properties": {
              "source": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "line",
                  "endLine"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "line": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "endLine": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              "reference": {
                "type": "string"
              },
              "resolution": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "reference",
          "reason",
          "candidates"
        ],
        "properties": {
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "line",
              "endLine"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "endLine": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "reference": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "candidates": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
